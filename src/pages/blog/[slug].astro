---
export const prerender = false;

import "../../styles/custom.css";
import Navigation from "../../components/Navigation.astro";

// Get the slug from the URL
const params = Astro.params;

// WordPress API URL for fetching a post by slug
const apiUrl = `https://qincai.xyz/wp-json/wp/v2/posts?slug=${params.slug}`;

let post = null;
let postContent = "<p>No content available.</p>";
let isError = false;

try {
  // Fetch the post data
  const response = await fetch(apiUrl);
  
  if (!response.ok) {
    // Handle HTTP errors (e.g., 404, 500)
    isError = true;
  } else {
    const postData = await response.json();

    // Extract the first post from the response
    if (postData.length) {
      post = postData[0];
      postContent = post.content?.rendered || "<p>No content available.</p>";
    } else {
      // No post found for the given slug
      isError = true;
    }
  }
} catch (error) {
  // Handle network or other unexpected errors
  console.error("Error fetching post:", error);
  isError = true;
}
---

<html>
  <head>
    <title>{post?.title?.rendered || "Post Not Found"} - QinCai's Website (Astro Version)</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="https://i0.wp.com/qincai.xyz/wp-content/uploads/2025/03/cropped-cropped-2142d56d-351f-4087-8f37-f47ddd0e6913-removebg-preview-1-e1723583321653.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="UTF-8">
  </head>
  <body>
    <Navigation />
    <div class="content-container">
      {isError ? (
        <div class="error-container">
          <h1>Post Not Found</h1>
          <p>Sorry, the post you are looking for does not exist or an error occurred while trying to fetch it.</p>
          <a href="/" class="back-home">Go Back to Home</a>
        </div>
      ) : (
        <>
          <h1>{post.title.rendered}</h1>
          <p>{new Date(post.date).toLocaleDateString()}</p>

          <!-- Render featured image if available -->
          {post.jetpack_featured_media_url ? (
            <img src={post.jetpack_featured_media_url} alt={post.title.rendered} class="featured-image" />
          ) : null}

          <div class="blog-content" set:html={postContent}></div>
        </>
      )}
    </div>
  </body>
</html>

<style>
  /* Add some padding to prevent content from being hidden under fixed navbar */
  .content-container {
    padding-top: 1rem;
  }

  .error-container {
    text-align: center;
    padding: 2rem;
  }

  .error-container h1 {
    font-size: 2rem;
    color: #e53e3e;
  }

  .error-container p {
    font-size: 1.125rem;
    color: #4a5568;
    margin-bottom: 1rem;
  }

  .error-container .back-home {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: #4c51bf;
    color: #ffffff;
    text-decoration: none;
    border-radius: 0.375rem;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .error-container .back-home:hover {
    background-color: #3c418d;
  }

  .blog-content {
    font-size: 1.125rem;
    line-height: 1.75;
    max-width: 720px;
    margin: auto;
    text-align: justify;
  }

  .featured-image {
    width: 100%;
    max-width: 720px;
    display: block;
    margin: 1.5rem auto;
    border-radius: 0.75rem;
    box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.1);
  }
</style>
